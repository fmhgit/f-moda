# 端点名称（每个端点用不同名字区分）
NAME=point-1
# ModelScope API Key（调度端不传 x-api-key 时的兜底）
# 复制本文件为 .env 后填真实值；.env 已被 .gitignore / .dockerignore 排除
API_KEY=ms-your-key
# 默认模型
MODEL=Qwen/Qwen3.5-35B-A3B
# 私有认证 Key（和调度端 auth_key 一致，请用强随机串）
AUTH_KEY=change-me-random-string
# 日志级别: debug / info / warn / error
LOG_LEVEL=info
# 流式 chunk 超时 (ms)
TIMEOUT_STREAM_CHUNK=180000
# 重试状态码（逗号分隔）
RETRY_ON_STATUS=429,500,502,503,504
